PORT=4000
NODE_ENV=production
CORS_ORIGINS=https://keoco.vercel.app,http://localhost:5173
DATABASE_URL=postgresql://postgres.<ref>:<DB_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
ADMIN_API_KEY=your_admin_secret_key_here
SESSION_SECRET=your_session_secret_key_here
WIN_SCORE=10
BUZZ_TIMEOUT_SEC=15
ANSWER_TIMEOUT_SEC=10
REBOUND_TIMEOUT_SEC=8
MAX_PLAYERS_PER_TEAM=5
MATCH_TIME_LIMIT_SEC=600
RECONNECT_GRACE_SEC=30
